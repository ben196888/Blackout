{
  "name": "pace-poc",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "pnpm": "11.15.1"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsup src/server.ts --format cjs --platform node --target node24 --out-dir dist-server --clean",
    "start": "node dist-server/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "playwright test",
    "smoke:production": "PLAYWRIGHT_BASE_URL=https://pace-poc.fly.dev playwright test"
  },
  "dependencies": {
    "boardgame.io": "0.50.2",
    "koa-static": "5.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/koa-static": "4.0.4",
    "@types/node": "24.3.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.5",
    "tsup": "8.5.1",
    "typescript": "5.9.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
